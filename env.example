# Copy to .env (gitignored). run_daily.sh sources it before Phase C.
# Cloudflare Pages deploy (see cloudflare-setup.md)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# OpenRouter roster sync (config/roster.yaml). Any key works; the two endpoints
# are free, one call each per run. Without it the sync fails closed (allowlist frozen).
OPENROUTER_API_KEY=
