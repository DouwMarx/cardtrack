# Copy to infra/prod.env (gitignored); infra/push-secrets.sh delivers it as the host's .env.
CARDTRACK_ROLE=prod
# `claude setup-token`, approved in the browser as the pipeline's own Claude account.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_TOKEN_CREATED=YYYY-MM-DD
# Fine-grained PAT: this repo only; Contents read/write, Issues read/write; 1-year expiry.
GH_TOKEN=
# Cloudflare Pages deploy (see cloudflare-setup.md)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# OpenRouter roster sync (any key; the endpoints used are free)
OPENROUTER_API_KEY=
# Optional off-site copy of data/raw (Cloudflare R2, S3 API token): scripts/backup.sh
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
# optional public archive bucket (settings archive.public_base_url)
R2_PUBLIC_BUCKET=
