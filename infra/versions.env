# Pinned tool versions for a production host (infra/bootstrap.sh). Bump deliberately,
# after running the daily pipeline once on the new version from a dev checkout.
CLAUDE_CODE_VERSION=2.1.280
UV_VERSION=0.11.21
# Node.js for npx wrangler/pagefind. Debian 13 ships 20, but wrangler 4.143 needs
# >= 22 (the first deploy from a server would have failed; found 2026-10-01).
NODE_VERSION=22.23.3
# rclone for the R2 backup and `rclone serve s3` in tests (>= 1.65); Debian's is older.
RCLONE_VERSION=1.74.4
