# raw blobs are local-only insurance, never published (spec §2.8)
data/raw/

# venv / tooling
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage

# secrets (see env.example)
.env

# run state (state/: markers the agent sandbox cannot write)
state/
.run.lock
.agent-home/
config/*.tmp

# logs/: everything is local run output EXCEPT the allow-list below. The daily
# commit stages these same paths by name (scripts/run_daily.sh), so a stray file
# in logs/ can never reach git. Local ledgers (comments.jsonl, *.sent.jsonl), the
# OpenRouter snapshot, run logs, transcripts and the security quarantine
# (*.held.jsonl, SECURITY_HOLD.md) all stay on disk only.
logs/*
!logs/friction.jsonl
!logs/PROPOSALS.md
!logs/RESOLVED.md
!logs/run_report.md
!logs/issues_outbox.jsonl
!logs/comments_outbox.jsonl
!logs/archive/
!logs/archive/**
.wrangler/

# pagefind output is derived from the (tracked) rendered pages AND is
# nondeterministic between identical builds — tracked, it reshuffles ~250
# content-hashed shards every run. Deploy uses the working tree, not git;
# a clean clone regenerates it with `poe build`.
site/pagefind/

# production secrets (infra/push-secrets.sh)
infra/prod.env

# research report: generated intermediates (report/published/ is the tracked edition)
report/data/
report/pairs/
report/out/
report/tex/*.pdf
report/tex/*.png
report/tex/*.aux
report/tex/*.bbl
report/tex/*.blg
report/tex/*.fdb_latexmk
report/tex/*.fls
report/tex/*.log
report/tex/*.out
