# raw blobs are local-only insurance, never published (spec §2.8)
data/raw/

# venv / tooling
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage

# secrets (see env.example)
.env

# run state
.run.lock
.agent-home/
logs/.phase_b_started
logs/.agent_last_success
logs/.agent_failstreak

# raw logs are noise; run_report.md, friction.jsonl, issues_outbox.jsonl stay tracked
logs/*.log
logs/run-*.log
logs/cron.log
logs/candidates.json
logs/state_summary.json
logs/open_issues.json
logs/agent-transcripts/
logs/updated_docs.json
logs/version_diffs/
# security quarantine: may contain the very secrets the scan caught — never commit
logs/*.held.jsonl
logs/SECURITY_HOLD.md
.wrangler/

# pagefind output is derived from the (tracked) rendered pages AND is
# nondeterministic between identical builds — tracked, it reshuffles ~250
# content-hashed shards every run. Deploy uses the working tree, not git;
# a clean clone regenerates it with `poe build`.
site/pagefind/
