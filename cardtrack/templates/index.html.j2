<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_title }} — AI model documentation index</title>
<link rel="icon" type="image/svg+xml" href="./favicon.svg?v={{ asset_v['favicon.svg'] }}">
<link rel="stylesheet" href="./style.css?v={{ asset_v['style.css'] }}">
</head>
<body>
<header class="masthead">
  <div>
    <h1>{{ site_title }}</h1>
  </div>
  <nav>
    <a href="./search.html">Full-text search</a>
    <a href="./about.html">About</a>
    {% if gh_repo %}<a href="https://github.com/{{ gh_repo }}">GitHub</a>{% endif %}
  </nav>
</header>

<section class="controls" aria-label="filters">
  <input id="q" type="search" placeholder="Filter by title, model, publisher, or year…"
         autocomplete="off" spellcheck="false">
  <details class="msel" id="f-publisher">
    <summary>publisher: all</summary><div class="msel-panel"></div>
  </details>
  <details class="msel" id="f-doctype">
    <summary>type: all</summary><div class="msel-panel"></div>
  </details>
  <select id="f-independent">
    <option value="">source: all</option>
    <option value="1">independent</option>
    <option value="0">first-party</option>
  </select>
  <select id="f-safety">
    <option value="">safety evals: all</option>
    <option value="1">has safety evals</option>
    <option value="0">no safety evals</option>
    <option value="null">unassessed</option>
  </select>
  <select id="f-openness">
    <option value="">openness: all</option>
    <option value="closed">closed</option>
    <option value="open_weight_restrictive">open (restrictive)</option>
    <option value="open_weight_permissive">open (permissive)</option>
    <option value="mixed">mixed</option>
    <option value="null">n/a</option>
  </select>
  <button id="export" type="button" title="CSV of the current filtered view">Export CSV</button>
  <details class="columns-toggle">
    <summary>Columns</summary>
    <div id="column-boxes"></div>
  </details>
</section>

<p id="count" class="count" aria-live="polite">Loading…</p>

<div class="table-wrap">
  <table id="tbl">
    <thead><tr id="tbl-head"></tr></thead>
    <tbody id="tbl-body"></tbody>
  </table>
</div>

<footer>
  <p>Metadata filter searches identity fields only; for content questions use
     <a href="./search.html">full-text search</a>. Built {{ generated_at }} ·
     {{ doc_count }} documents{% if gh_repo %} ·
     <a href="https://github.com/{{ gh_repo }}/issues/new?labels=missing-doc&title=%5Bmissing-doc%5D">report a missing document</a>{% endif %}
  </p>
</footer>
<script src="./msel.js?v={{ asset_v['msel.js'] }}"></script>
<script src="./app.js?v={{ asset_v['app.js'] }}"></script>
</body>
</html>
