[Unit]
Description=cardtrack daily run (monitor, curation agent, build, publish)
After=network-online.target
# Retry budget: at most 5 starts per day (the timer's own start counts as one),
# so a persistently broken day cannot loop.
StartLimitIntervalSec=1d
StartLimitBurst=5

[Service]
Type=oneshot
WorkingDirectory=%h/projects/ais/system_card_db
ExecStart=%h/projects/ais/system_card_db/scripts/run_daily.sh
# run_daily.sh sets its own PATH and holds its own lock
# Hang backstop: Type=oneshot has NO default timeout, and a wedged run would
# hold the flock forever — every later run would then exit 0 silently.
RuntimeMaxSec=4h
# Retry a failed day while the machine is still on. run_daily.sh exits 75 when
# the network never came up (nothing done), 3 when the agent phase failed, 4
# when link checks all errored (network dropped mid-run). Exit 1 is a security
# hold that only a human can clear, so it is never retried.
Restart=on-failure
RestartSec=30min
RestartPreventExitStatus=1
