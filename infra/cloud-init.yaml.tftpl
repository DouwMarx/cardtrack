#cloud-config
# First boot of a cardtrack host. Everything except secrets; see infra/README.md.
# Keep root login with the Hetzner-injected key (re-running bootstrap.sh needs root).
disable_root: false
users:
  - default
  - name: cardtrack
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}
package_update: true
packages: [git, ca-certificates, curl]
runcmd:
%{ if tailscale_auth_key != "" ~}
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key='${tailscale_auth_key}' --ssh --hostname='${name}' --advertise-tags=tag:cardtrack
%{ endif ~}
  - git clone -q '${repo_url}' /opt/cardtrack-bootstrap
  - bash /opt/cardtrack-bootstrap/infra/bootstrap.sh '${repo_url}' cardtrack > /var/log/cardtrack-bootstrap.log 2>&1
