<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ doc.title }} — {{ site_title }}</title>
<link rel="icon" type="image/svg+xml" href="../favicon.svg?v={{ asset_v['favicon.svg'] }}">
<link rel="stylesheet" href="../style.css?v={{ asset_v['style.css'] }}">
</head>
<body>
<header class="masthead">
  <div>
    <h1><a href="../index.html">{{ site_title }}</a></h1>
  </div>
  <nav><a href="../index.html">Table</a> <a href="../search.html">Search</a> <a href="../about.html">About</a></nav>
</header>

<article class="doc">
  <h2 data-pagefind-meta="title">{{ doc.title }}</h2>

  <dl class="meta">
    <dt>Publisher</dt>
    <dd>{% if publisher_home %}<a href="{{ publisher_home }}" rel="noopener nofollow"><span data-pagefind-filter="publisher" data-pagefind-meta="publisher">{{ doc.publisher }}</span></a>
        {% else %}<span data-pagefind-filter="publisher" data-pagefind-meta="publisher">{{ doc.publisher }}</span>{% endif %}
        {% if doc.is_independent %}<span class="badge independent" data-pagefind-filter="source">independent</span>
        {% else %}<span class="badge" data-pagefind-filter="source">first-party</span>{% endif %}
        {% if doc.safety_evals is not none %}<span hidden data-pagefind-filter="safety:{{ 'yes' if doc.safety_evals == 1 else 'no' }}"></span>{% endif %}
        <span hidden data-pagefind-filter="openness:{{ doc.openness or 'na' }}"></span>
        <span hidden data-pagefind-meta="source_kind:{{ source_kind }}"></span></dd>
    <dt>Type</dt>
    <dd><span data-pagefind-filter="type">{{ doc.doc_type }}</span></dd>
    <dt>Models</dt>
    <dd>{{ doc.model_names | join(", ") if doc.model_names else "—" }}</dd>
    <dt>Published</dt>
    <dd><span data-pagefind-meta="date">{{ doc.publication_date or "unknown" }}</span>
        <span data-pagefind-filter="year" hidden>{{ year }}</span></dd>
    <dt>Status</dt>
    <dd><span class="badge status-{{ doc.status }}">{{ doc.status }}</span></dd>
    <dt>Safety evals</dt>
    <dd>{% if doc.safety_evals == 1 %}<span class="badge safety-yes">yes</span>
        {% elif doc.safety_evals == 0 %}<span class="badge safety-no">none found</span>
        {% else %}<span class="badge">unassessed</span>{% endif %}</dd>
    {% if doc.risk_domains %}
    <dt>Risk domains</dt>
    <dd>{% for r in doc.risk_domains %}<span class="badge risk-domain">{{ risk_labels.get(r, r) }}</span>
        <span hidden data-pagefind-filter="risk:{{ r }}"></span>{% endfor %}</dd>
    {% endif %}
    <dt>Openness</dt>
    <dd>{% if doc.openness == 'restricted' %}<span class="badge openness-restricted">restricted access</span>
        {% elif doc.openness == 'closed' %}<span class="badge openness-closed">closed weights</span>
        {% elif doc.openness == 'open_weight_restrictive' %}<span class="badge openness-restrictive">open weights (restrictive license)</span>
        {% elif doc.openness == 'open_weight_permissive' %}<span class="badge openness-permissive">open weights (permissive license)</span>
        {% else %}<span class="badge">n/a</span>{% endif %}</dd>
    <dt>Source</dt>
    <dd>
      <a href="{{ doc.canonical_url }}" rel="noopener nofollow" data-pagefind-meta="source_url[href]">{{ doc.canonical_url }}</a>
      {% if doc.status == 'dead' %} <span class="warn">(link was dead at last check; extracted text below is retained)</span>
      {% elif doc.status == 'moved' %} <span class="warn">(document has moved; link may redirect)</span>
      {% elif doc.status == 'superseded' %} <span class="warn">(superseded by a newer document)</span>
      {% endif %}
    </dd>
    {% if doc.alt_urls %}
    <dt>Previous URLs</dt>
    <dd>{% for u in doc.alt_urls %}<a href="{{ u }}" rel="noopener nofollow">{{ u }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</dd>
    {% endif %}
    {% if doc.related_urls %}
    <dt>Related</dt>
    <dd>{% for r in doc.related_urls %}
        {% if r.url.startswith('http://') or r.url.startswith('https://') %}
        <span class="related-item"><span class="badge">{{ r.kind | replace('_', ' ') }}</span>
        <a href="{{ r.url }}" rel="noopener nofollow">{{ r.url }}</a>{% if r.note %} — {{ r.note }}{% endif %}</span>{% if not loop.last %}<br>{% endif %}
        {% endif %}
    {% endfor %}</dd>
    {% endif %}
    <dt>First seen</dt>
    <dd>{{ doc.first_seen }}</dd>
    <dt>Versions</dt>
    <dd>{{ doc.version_count }}</dd>
    {% if notes %}
    <dt>Notes</dt>
    <dd>{{ notes }}</dd>
    {% endif %}
  </dl>

  {% if issue_url %}
  <p><a class="button" href="{{ issue_url }}" rel="noopener">Report an issue with this entry</a></p>
  {% endif %}

  <section>
    <h3>Version history</h3>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Fetched</th><th>Content type</th><th>Size</th><th>Fingerprint</th><th>What changed</th></tr></thead>
      <tbody>
      {% for v in versions %}
        <tr>
          <td>{{ v.fetched_at }}</td>
          <td>{{ v.content_type or "?" }}</td>
          <td>{{ "{:,}".format(v.byte_size) if v.byte_size else "?" }}</td>
          <td><code title="{{ v.content_fingerprint }}">{{ v.content_fingerprint[:16] }}</code></td>
          <td class="change-summary">{% if v.change_summary %}{{ v.change_summary }}
              {% elif loop.last %}<span class="muted">initial version</span>
              {% else %}<span class="muted">—</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </section>

  <section>
    <h3>Provenance</h3>
    <details>
    <summary>Show {{ provenance | length }} changelog entr{{ 'y' if provenance | length == 1 else 'ies' }}
      (when, how, and why this entry changed)</summary>
    <ol class="provenance">
    {% for entry in provenance %}
      <li>
        <span class="ts">{{ entry.ts }}</span>
        <strong>{{ entry.action }}</strong>
        <span class="run">run {{ entry.run_id }}{% if entry.detail.actor %} · {{ entry.detail.actor }}{% endif %}{% if entry.detail.source_of_lead %} · lead: {{ entry.detail.source_of_lead }}{% endif %}</span>
        {% if entry.detail.field %}
          <div class="just">{{ entry.detail.field }}: {{ entry.detail.old | tojson }} → {{ entry.detail.new | tojson }}</div>
        {% elif entry.action == 'status_change' %}
          <div class="just">{{ entry.detail.old }} → {{ entry.detail.new }}</div>
        {% endif %}
        {% if entry.detail.justification %}
          <div class="just">{{ entry.detail.justification }}</div>
        {% endif %}
        {% if entry.detail.validator_criteria or entry.detail.criteria %}
          <div class="evidence">Criteria:
            {% for k, v in (entry.detail.validator_criteria or {}).items() %}
              {{ k }}={{ 'pass' if v else 'FAIL' }}{{ ";" if not loop.last }}
            {% endfor %}
            {% for k, v in (entry.detail.criteria or {}).items() %}
              · attested {{ k }}={{ v | lower }}
            {% endfor %}
          </div>
        {% endif %}
        {% if entry.detail.evidence_urls %}
          <div class="evidence">Evidence:
          {% for u in entry.detail.evidence_urls %}
            {% if u.startswith('http://') or u.startswith('https://') %}<a href="{{ u }}" rel="noopener nofollow">{{ u }}</a>{% else %}{{ u }}{% endif %}{% if not loop.last %} · {% endif %}
          {% endfor %}
          </div>
        {% endif %}
      </li>
    {% endfor %}
    </ol>
    </details>
  </section>

  <section>
    <h3>Extracted text</h3>
    {% if text %}
    <details>
      <summary>Show extracted text (from the latest fetched version; formatting is lossy —
        use the <a href="{{ doc.canonical_url }}" rel="noopener nofollow">original</a> for reading)</summary>
      <pre class="extracted" data-pagefind-body>{{ text }}</pre>
    </details>
    {% else %}
    <p>Text extraction is unavailable for this document.</p>
    {# keep the doc findable in full-text search even without extracted text #}
    <div data-pagefind-body hidden>{{ doc.title }} — {{ doc.publisher }} —
      {{ doc.model_names | join(", ") }}</div>
    {% endif %}
  </section>
</article>

<footer><p>Built {{ generated_at }}</p></footer>
</body>
</html>
