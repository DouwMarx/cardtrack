<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="script-src 'none'; object-src 'none'; base-uri 'none'">
<title>Analysis — {{ site_title }}</title>
<link rel="icon" type="image/svg+xml" href="./favicon.svg?v={{ asset_v['favicon.svg'] }}">
<link rel="stylesheet" href="./style.css?v={{ asset_v['style.css'] }}">
</head>
<body>
<header class="masthead">
  <div><h1><a href="./index.html">{{ site_title }}</a> / analysis</h1></div>
  <nav>
    <a href="./index.html">Table</a>
    <a href="./search.html">Search</a>
    <a href="./about.html">About</a>
    {% if gh_repo %}<a href="https://github.com/{{ gh_repo }}">GitHub</a>{% endif %}
  </nav>
</header>

<article class="doc report">
  <aside class="disclaimer" role="note">
    <p><strong>AI-generated report.</strong> This report was generated by
    {{ analysis.model_name }} (<code>{{ analysis.model }}</code>) using the
    <a href="{{ analysis.skill_url }}">cardtrack-report skill</a>.
    It is regenerated weekly from the live database and published automatically;
    maintainers review each edition afterwards and refine the skill.</p>
    <p class="edition">Generated {{ analysis.generated_at[:10] }}{% if analysis.snapshot %} from a
    database snapshot taken {{ analysis.snapshot[:10] }}{% endif %}.{% if analysis.has_pdf %}
    <a href="./analysis/report.pdf">PDF version</a>.{% endif %}</p>
  </aside>
  {{ analysis.html | safe }}
</article>
</body>
</html>
