# Copy to .env (gitignored). Read key by key by the scripts (scripts/lib.sh envget);
# never sourced wholesale before the agent runs, and every key here is unset inside
# the agent sandbox.
#
# prod (default): publish, file alert issues, pull new code before each run.
# dev: run everything locally, publish nothing. Use dev on development machines.
CARDTRACK_ROLE=dev
# Claude: a `claude setup-token` token for the pipeline's own account (recommended on
# unattended hosts), or leave empty to use the /login session in CLAUDE_CONFIG_DIR.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_TOKEN_CREATED=
# CLAUDE_CONFIG_DIR=~/.claude-cardtrack
# Cloudflare Pages deploy (see cloudflare-setup.md)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# OpenRouter roster sync (config/roster.yaml). Any key works; the two endpoints
# are free, one call each per run. Without it the sync fails closed (allowlist frozen).
OPENROUTER_API_KEY=
# Optional off-site copy of data/raw to Cloudflare R2 (scripts/backup.sh)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
# optional public archive bucket (settings archive.public_base_url)
R2_PUBLIC_BUCKET=
